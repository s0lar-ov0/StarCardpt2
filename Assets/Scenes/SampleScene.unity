  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- <b>\u8FDE\u7ED3</b>\uFF1A\u540C\u4E00\u65B9\u4F4D\u81F3\u5C11 3 \u5F20\u661F\u5BBF\u724C\u843D\u5728\u672C\u65B9\u4F4D\u9635\u578B\u6A21\u677F\u7684\u683C\u5B50\u4E0A\uFF08\u6A21\u677F\u53EF\u5E73\u79FB\uFF0C\u4E0D\u53EF\u65CB\u8F6C\uFF09\uFF0C\u8FD9\u4E9B\u724C\u5373\u8FDB\u5165\u8FDE\u7ED3\u72B6\u6001\u3002\u8FDE\u7ED3\u7684\u724C\u5728\u6F02\u79FB\u4E2D\u4E0D\u4F1A\u88AB\u5439\u8D70\u3002\n-
    <b>\u5F52\u4F4D</b>\uFF1A\u67D0\u65B9\u4F4D 7 \u5BBF\u5168\u90E8\u586B\u6EE1\u4E00\u4E2A\u9635\u578B\u6446\u653E\u65F6\uFF0C\u8BE5\u65B9\u4F4D\u5F52\u4F4D
    \u2014\u2014 \u8FD9\u4E9B\u724C\u4ECE\u68CB\u76D8\u4E0E\u5361\u6C60\u4E2D\u6D88\u5931\uFF0C\u73A9\u5BB6\u83B7\u5F97\u8BE5\u65B9\u4F4D\u7684\u6C38\u4E45\u795D\u798F\u3002\u56DB\u65B9\u4F4D\u5168\u90E8\u5F52\u4F4D\u5373\u901A\u5173\u3002\n\xB7
    <b>\u884C\u52A8</b>\uFF1A\u653E\u7F6E\u624B\u724C / \u79FB\u52A8\u68CB\u76D8\u4E0A\u7684\u724C
    / \u4EA4\u6362\u4E24\u5F20\u724C\uFF0C\u5404\u7B97\u4E00\u6B21\u884C\u52A8\u3002\u884C\u52A8\u6B21\u6570\u7528\u5C3D\u5373\u81EA\u52A8\u7ED3\u675F\u56DE\u5408\u3002\n\xB7
    <b>\u6F02\u79FB</b>\uFF1A\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u68CB\u76D8\u4E0A\u6240\u6709\u975E\u8FDE\u7ED3\u7684\u724C\u968F\u673A\u79FB\u52A8\u5230\u5176\u4ED6\u5408\u6CD5\u7A7A\u4F4D
    \u2014\u2014 \u4E5F\u53EF\u80FD\u56E0\u6B64\u51D1\u6210\u8FDE\u7ED3\u751A\u81F3\u5F52\u4F4D\u3002\n\xB7
    <b>\u968F\u673A\u4E8B\u4EF6</b>\uFF1A\u68CB\u76D8\u64CD\u4F5C\u9636\u6BB5\u6BCF\uFF085
    \u2212 \u5DF2\u5F52\u4F4D\u65B9\u4F4D\u6570\uFF09\u6B21\u884C\u52A8\u89E6\u53D1\u4E00\u6B21\uFF0C\u53EF\u80FD\u662F\u597D\u4E8B\u4E5F\u53EF\u80FD\u662F\u574F\u4E8B\u3002\n\xB7
    <b>\u6D41\u661F\u5B9A\u4F4D</b>\uFF1A\u6BCF\u56DE\u5408\u5F00\u5934\u7684\u9650\u65F6\u5C0F\u6E38\u620F\u3002\u5927\u578B\u767D\u8272\uFF08\u6162\uFF09=
    \u884C\u52A8\u6B21\u6570 +1\uFF1B\u4E2D\u578B\u5C5E\u6027\u8272\uFF08\u4E2D\uFF09=
